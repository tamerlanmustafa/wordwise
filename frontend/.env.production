# Production Backend API URL
# Note: .github/workflows/deploy.yml sets VITE_API_URL in the build env, and
# Vite gives existing process env vars priority over .env files — so this value
# only applies to a local `npm run build`, not the deployed site.
VITE_API_URL=https://api.getwordwise.us

# Google OAuth Client ID (public by design — safe to ship to the browser)
VITE_GOOGLE_CLIENT_ID=400446242104-gvfqp0soikdji99132k59nlh88moucpt.apps.googleusercontent.com

# NOTE: The TMDB API key was removed from here. It is unused by the web app
# (TMDB is proxied through the backend), and any VITE_* value is bundled into
# the public client JS, so it must never hold a secret. ROTATE the old key
# (9dece7a3…, now burned in git history) in your TMDB account.
