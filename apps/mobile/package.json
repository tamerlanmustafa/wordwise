{
  "name": "WordWiseMobile",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:ios": "eas build --profile development --platform ios",
    "lint": "eslint .",
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "start:dev-full": "concurrently \"cd ../../backend && uvicorn src.main:app --reload --host 0.0.0.0 --port 8000\" \"expo start --dev-client\"",
    "start:full": "concurrently \"cd ../../backend && uvicorn src.main:app --reload --host 0.0.0.0 --port 8000\" \"expo start\"",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native/new-app-screen": "0.81.5",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.9.0",
    "@shopify/flash-list": "2.0.2",
    "axios": "^1.13.2",
    "babel-preset-expo": "^54.0.9",
    "expo": "~54.0.37",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "~7.0.11",
    "expo-av": "~16.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.24",
    "expo-glass-effect": "~0.1.10",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-localization": "~17.0.9",
    "expo-media-library": "~18.2.1",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "^15.0.8",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "i18next": "^25.10.10",
    "intl-pluralrules": "^2.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^15.7.4",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.9"
