{
  "name": "wordwise",
  "version": "2.0.0",
  "description": "WordWise - Language Learning Platform",
  "private": true,
  "scripts": {
    "db:studio": "cd backend && prisma studio --port 5555",
    "db:push": "cd backend && prisma db push",
    "db:migrate": "cd backend && prisma migrate dev",
    "db:generate": "cd backend && prisma generate",
    "db:seed": "cd backend && python -m src.scripts.seed",
    "backend": "cd backend && uvicorn src.main:app --reload --host 0.0.0.0 --port 8000",
    "frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "shell:db": "psql -U wordwise_user -d wordwise_db",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prepare": "husky",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:mobile",
    "typecheck:frontend": "cd frontend && tsc -b --noEmit",
    "typecheck:mobile": "cd apps/mobile && tsc --noEmit"
  },
  "lint-staged": {
    "backend/**/*.py": [
      "bash -c 'command -v ruff >/dev/null 2>&1 && ruff check --fix --config backend/ruff.toml \"$@\" || echo \"[lint-staged] ruff not on PATH, skipping (activate venv or: pip install ruff)\"' _"
    ]
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "concurrently": "^8.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "expo": "^54.0.31",
    "react-dom": "19.1.0",
    "react-native-web": "^0.21.0",
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
