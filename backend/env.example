# Database
DATABASE_URL=postgresql://wordwise_user:wordwise_password@localhost:5432/wordwise_db

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Application
APP_NAME=WordWise
APP_VERSION=1.0.0
DEBUG=True

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Redis (Optional)
REDIS_URL=redis://localhost:6379/0

# Rate limiting (issue #74): app-wide abuse ceiling per authenticated user
# (falls back to client IP), enforced in-process. Per-endpoint throttles stack
# on top for cost-incurring paths. Set ENABLED=false or PER_MINUTE=0 to disable.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=600

# Where the caller's address is (issue #139). Anonymous throttles key on it, so
# if it resolves to a proxy rather than a caller the limits do not bind.
#
# TRUSTED_PROXY_HOPS: how many proxies append to X-Forwarded-For in front of
# this process; the caller is that many entries from the RIGHT. Leave at 0
# (ignore the header, key on the socket peer) unless you know the chain —
# too high hands out spoofable identities. Railway rebuilds the header and
# discards Cloudflare's, so on Railway no value of this works; leave it unset.
TRUSTED_PROXY_HOPS=0
#
# TRUSTED_CLIENT_IP_HEADER: the single-value header a CDN uses to carry the
# real caller (Cloudflare: CF-Connecting-IP). It is honoured ONLY when the
# origin secret below also matches, because the origin still answers requests
# that never went through the CDN — a header anyone can set would let every
# caller mint their own rate-limit identity. Both empty = feature off.
# Set the secret with a Cloudflare Transform Rule on requests to the origin.
TRUSTED_CLIENT_IP_HEADER=
TRUSTED_CLIENT_IP_SECRET_HEADER=
TRUSTED_CLIENT_IP_SECRET=

# External APIs (Optional)
OXFORD_API_KEY=your-oxford-api-key
OXFORD_APP_ID=your-oxford-app-id
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key

# Transactional email (Resend). Leave the key empty to disable sending —
# every email becomes a logged no-op. EMAIL_FROM's domain must be verified
# in the Resend dashboard. API_PUBLIC_URL builds the verification links.
RESEND_API_KEY=
EMAIL_FROM=WordWise <no-reply@getwordwise.us>
API_PUBLIC_URL=https://api.getwordwise.us

# Anthropic (example sentence generation)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_SENTENCE_MODEL=claude-haiku-4-5-20251001
# Hard ceiling on cumulative Anthropic spend (USD). Each LLM call writes to
# llm_usage_ledger; before each call we sum the ledger and refuse to fire if
# we're already at the cap. Set to 0 to disable.
LLM_COST_CAP_USD=50


