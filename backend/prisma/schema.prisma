generator client {
  provider                    = "prisma-client-py"
  recursive_type_depth        = "5"
  enable_experimental_decimal = "true"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int                      @id @default(autoincrement())
  email                   String                   @unique(map: "ix_users_email") @db.VarChar
  username                String                   @unique(map: "ix_users_username") @db.VarChar
  passwordHash            String?                  @map("password_hash") @db.VarChar
  languagePreference      String?                  @map("language_preference") @db.VarChar
  nativeLanguage          String?                  @default("en") @map("native_language") @db.VarChar(10)
  learningLanguage        String?                  @default("en") @map("learning_language") @db.VarChar(10)
  proficiencyLevel        proficiencylevel?        @map("proficiency_level")
  defaultTab              String?                  @default("movies") @map("default_tab") @db.VarChar(10)
  isActive                Boolean?                 @map("is_active")
  isAdmin                 Boolean?                 @map("is_admin")
  subscriptionTier        subscriptiontier?        @default(free) @map("subscription_tier")
  subscriptionExpiresAt   DateTime?                @map("subscription_expires_at") @db.Timestamptz(6)
  adsEligible             Boolean?                 @default(true) @map("ads_eligible")
  srsFreePreviewsUsed     Int?                     @default(0) @map("srs_free_previews_used")
  srsCurrentStreak        Int?                     @default(0) @map("srs_current_streak")
  srsLongestStreak        Int?                     @default(0) @map("srs_longest_streak")
  srsLastSessionDate      DateTime?                @map("srs_last_session_date") @db.Date
  // Set on every POST /srs/session/start. Used by the new daily-cap gate
  // (1 free session per UTC day, premium unlimited). Distinct from
  // srsLastSessionDate, which tracks per-card review activity for the streak.
  srsLastSessionStartedAt DateTime?                @map("srs_last_session_started_at") @db.Timestamptz(6)
  // v0.7.2 — which "practice tile" the user picked today (e.g.
  // 'quick_recall', 'synonym_round', 'tough_words', 'movie_deep_dive').
  // Cleared at UTC rollover by the daily-cap gate. The PracticeScreen
  // reads this back via /daily/state to render the matching tile as
  // "done today" + the others as "locked until tomorrow".
  srsLastSessionKind      String?                  @map("srs_last_session_kind") @db.VarChar(40)
  // UTC date of the last chest claim. Used to enforce one chest per
  // completed daily session — see /srs/session/complete.
  srsLastChestDate        DateTime?                @map("srs_last_chest_date") @db.Date
  // v0.6 cinema-named streak milestones (W10). JSON array of unlocked
  // keys: "opening_weekend" (7d), "box_office" (30d), "cult_classic"
  // (100d), "criterion_collection" (365d). Frontend diffs against a
  // local last-seen list to fire MilestoneUnlockModal on new entries.
  unlockedCosmetics       Json?                    @default("[]") @map("unlocked_cosmetics")
  srsTotalReviews         Int?                     @default(0) @map("srs_total_reviews")
  srsTotalCorrect         Int?                     @default(0) @map("srs_total_correct")
  // Dormant (2026-07-16): email verification was removed in favor of
  // password reset — nothing reads or writes these anymore. The columns stay
  // because dropping them is a destructive prod migration for zero gain.
  emailVerified           Boolean?                 @default(false) @map("email_verified")
  emailVerifiedAt         DateTime?                @map("email_verified_at") @db.Timestamptz(6)
  createdAt               DateTime?                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime?                @updatedAt @map("updated_at") @db.Timestamptz(6)
  oauthProvider           oauthprovider            @map("oauth_provider")
  googleId                String?                  @unique(map: "ix_users_google_id") @map("google_id") @db.VarChar
  appleId                 String?                  @unique(map: "ix_users_apple_id") @map("apple_id") @db.VarChar
  profilePictureUrl       String?                  @map("profile_picture_url") @db.VarChar
  wordLists               UserWordList[]
  translationHistory      UserTranslationHistory[]
  userWords               UserWord[]
  wordInteractions        UserWordInteraction[]
  reportsMade             WordReport[]             @relation("ReportedBy")
  reportsReviewed         WordReport[]             @relation("ReviewedBy")
  hiddenWords             HiddenWord[]             @relation("HiddenWordBy")
  quizSessions            QuizSession[]
  quizStats               UserQuizStats?
  unitProgress            UnitProgress[]
  reelMovies              UserReelMovie[]
  watchedMovies           UserWatchedMovie[]
  hiddenMovies            UserHiddenMovie[]
  movieProgress           UserMovieProgress[]
  streakFreezes           UserStreakFreeze[]
  featureFlags            UserFeatureFlag[]
  achievements            UserAchievement[]
  familyPlanOwned         FamilyPlan?
  familyMemberships       FamilyMember[]
  studentVerifications    StudentVerification[]

  @@index([id], map: "ix_users_id")
  @@map("users")
}

model Movie {
  id               Int                   @id @default(autoincrement())
  title            String                @db.VarChar
  actualTitle      String?               @map("actual_title") @db.VarChar
  year             Int
  genre            String?               @db.VarChar
  difficultyLevel  difficultylevel?      @map("difficulty_level")
  difficultyScore  Int?                  @map("difficulty_score")
  cefrDistribution Json?                 @map("cefr_distribution")
  script_text      String?
  wordCount        Int?                  @map("word_count")
  description      String?
  poster_url       String?               @db.VarChar
  tmdbId           Int?                  @unique @map("tmdb_id")
  tmdbPopularity   Float?                @map("tmdb_popularity")
  tmdbVoteAverage  Float?                @map("tmdb_vote_average")
  tmdbVoteCount    Int?                  @map("tmdb_vote_count")
  createdAt        DateTime?             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime?             @updatedAt @map("updated_at") @db.Timestamptz(6)
  // Relations
  words            Word[]
  movieScripts     MovieScript[]
  aliases          MovieAlias[]
  userWords        UserWord[]
  wordReports      WordReport[]
  lemmaMappings    MovieLemmaMapping[]
  sentences        SentenceBank[]
  wordInteractions UserWordInteraction[]
  userProgress     UserMovieProgress[]

  @@index([id], map: "ix_movies_id")
  @@index([title], map: "ix_movies_title")
  @@index([difficultyLevel], map: "ix_movies_difficulty")
  @@map("movies")
}

model Book {
  id               Int              @id @default(autoincrement())
  title            String           @db.VarChar
  author           String?          @db.VarChar
  year             Int?
  description      String?          @db.Text
  coverUrl         String?          @map("cover_url") @db.VarChar
  // External IDs
  gutenbergId      Int?             @unique @map("gutenberg_id")
  openLibraryKey   String?          @map("open_library_key") @db.VarChar
  isbn             String?          @db.VarChar
  // Analysis results
  difficultyLevel  difficultylevel? @map("difficulty_level")
  difficultyScore  Int?             @map("difficulty_score")
  cefrDistribution Json?            @map("cefr_distribution")
  wordCount        Int?             @map("word_count")
  // Timestamps
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  // Relations
  bookText         BookText?

  @@index([id], map: "ix_books_id")
  @@index([title], map: "ix_books_title")
  @@index([gutenbergId], map: "ix_books_gutenberg_id")
  @@index([difficultyLevel], map: "ix_books_difficulty")
  @@map("books")
}

model BookText {
  id                   Int                      @id @default(autoincrement())
  bookId               Int                      @unique @map("book_id")
  sourceType           booksourcetype           @map("source_type")
  rawText              String?                  @map("raw_text") @db.Text
  cleanedText          String?                  @map("cleaned_text") @db.Text
  cleanedWordCount     Int?                     @map("cleaned_word_count")
  processingMetadata   Json?                    @map("processing_metadata")
  // Original EPUB file content (for reader)
  epubContent          Bytes?                   @map("epub_content")
  // Page extraction info
  totalPages           Int?                     @map("total_pages")
  pageExtractionMethod String?                  @map("page_extraction_method") @db.VarChar(50)
  pageData             Json?                    @map("page_data") // Stores page boundaries
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  // Relations
  book                 Book                     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  wordClassifications  BookWordClassification[]

  @@index([bookId], map: "ix_book_texts_book_id")
  @@map("book_texts")
}

model BookWordClassification {
  id            Int                  @id @default(autoincrement())
  bookTextId    Int                  @map("book_text_id")
  word          String               @db.VarChar
  lemma         String               @db.VarChar
  pos           String?              @db.VarChar
  cefrLevel     proficiencylevel     @map("cefr_level")
  confidence    Float
  source        classificationsource
  frequencyRank Int?                 @map("frequency_rank")
  pageNumber    Int?                 @map("page_number") // Page where this word first appears
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  bookText      BookText             @relation(fields: [bookTextId], references: [id], onDelete: Cascade)

  @@index([bookTextId], map: "ix_book_word_classifications_book_text_id")
  @@index([lemma], map: "ix_book_word_classifications_lemma")
  @@index([cefrLevel], map: "ix_book_word_classifications_cefr_level")
  @@index([bookTextId, cefrLevel], map: "ix_book_word_classifications_book_cefr")
  @@index([pageNumber], map: "ix_book_word_classifications_page")
  @@map("book_word_classifications")
}

model MovieScript {
  id                  Int                  @id @default(autoincrement())
  movieId             Int                  @map("movie_id")
  sourceUsed          scriptsource         @map("source_used")
  rawSubtitleText     String?              @map("raw_subtitle_text") @db.Text
  cleanedScriptText   String?              @map("cleaned_script_text")
  cleanedWordCount    Int?                 @map("cleaned_word_count")
  tokenizedWords      Json?                @map("tokenized_words")
  cefrResults         Json?                @map("cefr_results")
  isPreprocessed      Boolean              @default(false) @map("is_preprocessed")
  isTruncated         Boolean              @default(false) @map("is_truncated")
  isComplete          Boolean              @default(true) @map("is_complete")
  processingMetadata  String?              @map("processing_metadata")
  fetchedAt           DateTime             @default(now()) @map("fetched_at") @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  movie               Movie                @relation(fields: [movieId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  wordClassifications WordClassification[]

  @@unique([movieId])
  @@index([movieId], map: "ix_movie_scripts_movie_id")
  @@index([sourceUsed], map: "ix_movie_scripts_source")
  @@map("movie_scripts")
}

model WordClassification {
  id            Int                  @id @default(autoincrement())
  scriptId      Int                  @map("script_id")
  word          String               @db.VarChar
  lemma         String               @db.VarChar
  pos           String?              @db.VarChar
  cefrLevel     proficiencylevel     @map("cefr_level")
  confidence    Float
  source        classificationsource
  frequencyRank Int?                 @map("frequency_rank")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  script        MovieScript          @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@index([scriptId], map: "ix_word_classifications_script_id")
  @@index([lemma], map: "ix_word_classifications_lemma")
  @@index([cefrLevel], map: "ix_word_classifications_cefr_level")
  @@index([scriptId, cefrLevel], map: "ix_word_classifications_script_cefr")
  @@map("word_classifications")
}

model Word {
  id               Int              @id @default(autoincrement())
  word             String           @db.VarChar
  definition       String?
  difficulty_level difficultylevel?
  frequency        Float?
  part_of_speech   String?          @db.VarChar
  example_sentence String?
  translation      String?          @db.VarChar
  movieId          Int?             @map("movie_id")
  userWordLists    UserWordList[]
  movie            Movie?           @relation(fields: [movieId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_words_id")
  @@index([word], map: "ix_words_word")
  @@map("words")
}

model UserWordList {
  id       Int       @id @default(autoincrement())
  userId   Int       @map("user_id")
  wordId   Int       @map("word_id")
  listType listtype  @map("list_type")
  added_at DateTime? @default(now()) @db.Timestamptz(6)
  user     User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  word     Word      @relation(fields: [wordId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_user_word_lists_id")
  @@map("user_word_lists")
}

model alembic_version {
  version_num String @id(map: "alembic_version_pkc") @db.VarChar(32)
}

model ScriptSourcePriority {
  id       Int          @id @default(autoincrement())
  source   scriptsource @unique
  priority Int

  @@index([priority], map: "ix_script_source_priority_priority")
  @@map("script_source_priorities")
}

model MovieAlias {
  id      Int    @id @default(autoincrement())
  movieId Int    @map("movie_id")
  alias   String @db.VarChar
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId], map: "ix_movie_aliases_movie_id")
  @@index([alias], map: "ix_movie_aliases_alias")
  @@map("movie_aliases")
}

model TranslationCache {
  id         Int      @id @default(autoincrement())
  sourceText String   @map("source_text") @db.VarChar
  sourceLang String?  @map("source_lang") @db.VarChar(10)
  targetLang String   @map("target_lang") @db.VarChar(10)
  translated String   @db.VarChar
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([sourceText, targetLang], map: "unique_translation")
  @@index([sourceText], map: "ix_translation_cache_source_text")
  @@index([targetLang], map: "ix_translation_cache_target_lang")
  @@map("translation_cache")
}

model UserTranslationHistory {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  word            String   @db.VarChar
  targetLang      String   @map("target_lang") @db.VarChar(10)
  translationUsed String   @map("translation_used") @db.VarChar
  provider        String?  @db.VarChar(20)
  translatedAt    DateTime @default(now()) @map("translated_at") @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "ix_user_translation_history_user_id")
  @@index([userId, word], map: "ix_user_translation_history_user_word")
  @@index([userId, translatedAt], map: "ix_user_translation_history_user_date")
  @@map("user_translation_history")
}

model UserWord {
  id                Int       @id @default(autoincrement())
  userId            Int       @map("user_id")
  word              String    @db.VarChar
  movieId           Int?      @map("movie_id")
  isLearned         Boolean   @default(false) @map("is_learned")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  // Leitner SRS state. Box 1 = new/forgot, box 5 = graduated.
  // Intervals: 1d, 3d, 7d, 14d, 30d. See src/routes/srs.py.
  srsBox            Int       @default(1) @map("srs_box")
  srsDueAt          DateTime  @default(now()) @map("srs_due_at") @db.Timestamptz(6)
  srsLastReviewedAt DateTime? @map("srs_last_reviewed_at") @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie             Movie?    @relation(fields: [movieId], references: [id], onDelete: SetNull)

  @@unique([userId, word, movieId], map: "unique_user_word_movie")
  @@index([userId], map: "ix_user_words_user_id")
  @@index([userId, isLearned], map: "ix_user_words_user_learned")
  @@index([userId, srsDueAt], map: "ix_user_words_user_due")
  @@map("user_words")
}

model UserWordInteraction {
  id              Int             @id @default(autoincrement())
  userId          Int             @map("user_id")
  word            String          @db.VarChar
  movieId         Int?            @map("movie_id")
  interactionType interactiontype @map("interaction_type")
  metadata        Json?
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie? @relation(fields: [movieId], references: [id], onDelete: SetNull)

  @@index([userId, word], map: "ix_user_word_interactions_user_word")
  @@index([userId, createdAt], map: "ix_user_word_interactions_user_date")
  @@index([word], map: "ix_user_word_interactions_word")
  @@map("user_word_interactions")
}

model WordSentenceExample {
  id           Int              @id @default(autoincrement())
  movieId      Int              @map("movie_id")
  word         String           @db.VarChar
  lemma        String           @db.VarChar
  cefrLevel    proficiencylevel @map("cefr_level")
  sentence     String           @db.Text
  translation  String           @db.Text
  targetLang   String           @map("target_lang") @db.VarChar(10)
  wordPosition Int              @map("word_position")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([movieId, word, sentence, targetLang], map: "unique_word_sentence_example")
  @@index([movieId], map: "ix_word_sentence_examples_movie_id")
  @@index([movieId, word], map: "ix_word_sentence_examples_movie_word")
  @@index([movieId, targetLang], map: "ix_word_sentence_examples_movie_lang")
  @@map("word_sentence_examples")
}

enum difficultylevel {
  BEGINNER
  ELEMENTARY
  INTERMEDIATE
  UPPER_INTERMEDIATE
  ADVANCED
  PROFICIENT
}

enum listtype {
  LEARN_LATER
  FAVORITES
  MASTERED
}

enum booksourcetype {
  GUTENBERG
  MANUAL_UPLOAD
  OPEN_LIBRARY
}

enum oauthprovider {
  email
  google
  facebook
}

enum proficiencylevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum scriptsource {
  STANDS4_PDF
  STANDS4_API
  SUBTITLE_SRT
  SUBTITLE_VTT
  SYNOPSIS
  MANUAL_UPLOAD
}

enum classificationsource {
  oxford_3000
  oxford_5000
  efllex
  evp
  frequency_backoff
  embedding_classifier
  fallback
}

enum sentencesource {
  subtitle
  llm
  tatoeba
  public_domain
}

enum interactiontype {
  ROW_CLICK
  TRANSLATION_VIEW
  DEFINITION_VIEW
  WORD_SAVE
  WORD_UNSAVE
}

enum reportreason {
  WRONG_TRANSLATION
  WRONG_CONTEXT
  WRONG_SPELLING
  INAPPROPRIATE_CONTENT
  OTHER
}

enum reportstatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum subscriptiontier {
  free
  trial
  premium
  comped
}

// Per-(user, movie) study state shown on reel tiles and used by the
// "Ready to Watch" recommendation surface. Tunable thresholds live in
// services/movie_progress_service.py.
enum moviestudystatus {
  unstudied
  studied
  mastered
}

// How a streak freeze was acquired. `iap` is the consumable freeze-pack
// purchase; `debug_grant` is dev-only credit (no IAP); `repair_grant` is
// reserved for future repair-flow integrations.
enum freezeacquisition {
  auto_weekly
  iap
  debug_grant
  repair_grant
}

// ============================================================
// V2 Context-Aware Translation System Models (Phase 1+)
// ============================================================

model Lemma {
  id              Int                  @id @default(autoincrement())
  lemma           String               @unique @db.VarChar
  pos             String?              @db.VarChar(10)
  cefrLevel       proficiencylevel     @map("cefr_level")
  confidence      Float                @default(0)
  source          classificationsource @default(fallback)
  frequencyRank   Int?                 @map("frequency_rank")
  wordForms       Json?                @map("word_forms")
  isMultiWord     Boolean              @default(false) @map("is_multi_word")
  priorityScore   Float                @default(0) @map("priority_score")
  totalMovieCount Int                  @default(1) @map("total_movie_count")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  senses        WordSense[]
  translations  TranslationMemory[]
  movieMappings MovieLemmaMapping[]
  sentenceLinks SentenceLemmaLink[]

  @@index([cefrLevel], map: "ix_lemmas_cefr_level")
  @@index([frequencyRank], map: "ix_lemmas_frequency_rank")
  @@index([priorityScore], map: "ix_lemmas_priority_score")
  @@map("lemmas")
}

model WordSense {
  id                     Int      @id @default(autoincrement())
  lemmaId                Int      @map("lemma_id")
  senseIndex             Int      @map("sense_index")
  pos                    String?  @db.VarChar(10)
  label                  String?  @db.VarChar(200)
  representativeSentence String?  @map("representative_sentence") @db.Text
  keywords               Json?
  clusterCentroid        Json?    @map("cluster_centroid")
  sentenceCount          Int      @default(0) @map("sentence_count")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  lemma            Lemma               @relation(fields: [lemmaId], references: [id], onDelete: Cascade)
  translations     TranslationMemory[]
  sentenceLinks    SentenceLemmaLink[]
  dominantInMovies MovieLemmaMapping[]

  @@unique([lemmaId, senseIndex], map: "unique_lemma_sense")
  @@index([lemmaId], map: "ix_word_senses_lemma_id")
  @@index([lemmaId, pos], map: "ix_word_senses_lemma_pos")
  @@map("word_senses")
}

model TranslationMemory {
  id                 Int      @id @default(autoincrement())
  lemmaId            Int      @map("lemma_id")
  senseId            Int      @map("sense_id")
  targetLang         String   @map("target_lang") @db.VarChar(10)
  translatedWord     String   @map("translated_word") @db.VarChar
  translatedSentence String?  @map("translated_sentence") @db.Text
  wordProvider       String   @map("word_provider") @db.VarChar(20)
  sentenceProvider   String?  @map("sentence_provider") @db.VarChar(20)
  usageCount         Int      @default(0) @map("usage_count")
  reportCount        Int      @default(0) @map("report_count")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  lemma Lemma     @relation(fields: [lemmaId], references: [id], onDelete: Cascade)
  sense WordSense @relation(fields: [senseId], references: [id], onDelete: Cascade)

  @@unique([lemmaId, senseId, targetLang], map: "unique_translation_memory")
  @@index([lemmaId, targetLang], map: "ix_translation_memory_lemma_lang")
  @@index([targetLang], map: "ix_translation_memory_target_lang")
  @@map("translation_memory")
}

model MovieLemmaMapping {
  id               Int      @id @default(autoincrement())
  movieId          Int      @map("movie_id")
  lemmaId          Int      @map("lemma_id")
  frequencyInMovie Int      @default(1) @map("frequency_in_movie")
  dominantSenseId  Int?     @map("dominant_sense_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  movie         Movie      @relation(fields: [movieId], references: [id], onDelete: Cascade)
  lemma         Lemma      @relation(fields: [lemmaId], references: [id], onDelete: Cascade)
  dominantSense WordSense? @relation(fields: [dominantSenseId], references: [id], onDelete: SetNull)

  @@unique([movieId, lemmaId], map: "unique_movie_lemma")
  @@index([movieId], map: "ix_movie_lemma_mapping_movie_id")
  @@index([lemmaId], map: "ix_movie_lemma_mapping_lemma_id")
  @@map("movie_lemma_mappings")
}

model SentenceBank {
  id           Int            @id @default(autoincrement())
  sentenceHash String         @map("sentence_hash") @db.VarChar(64)
  sentence     String         @db.Text
  // movieId NULL = global LLM-authored sentence shared across every movie
  // that has the linked lemma. movieId NOT NULL = legacy movie-tied row
  // (subtitle extraction or pre-global LLM backfill). Postgres treats NULL
  // ≠ NULL in unique constraints, so global dedup is enforced by a partial
  // unique index — see migration 2026_05_14_shared_sentences_and_cost_ledger.sql.
  movieId      Int?           @map("movie_id")
  source       sentencesource @default(subtitle)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  movie      Movie?              @relation(fields: [movieId], references: [id], onDelete: Cascade)
  lemmaLinks SentenceLemmaLink[]

  @@unique([sentenceHash, movieId], map: "sentence_bank_hash_movie_unique")
  @@index([movieId], map: "ix_sentence_bank_movie_id")
  @@index([sentenceHash], map: "ix_sentence_bank_sentence_hash")
  @@index([movieId, source], map: "ix_sentence_bank_movie_source")
  @@map("sentence_bank")
}

model LlmUsageLedger {
  id                  Int      @id @default(autoincrement())
  ts                  DateTime @default(now()) @db.Timestamptz(6)
  model               String   @db.VarChar(64)
  inputTokens         Int      @default(0) @map("input_tokens")
  cacheReadTokens     Int      @default(0) @map("cache_read_tokens")
  cacheCreationTokens Int      @default(0) @map("cache_creation_tokens")
  outputTokens        Int      @default(0) @map("output_tokens")
  estimatedCostUsd    Decimal  @default(0) @map("estimated_cost_usd") @db.Decimal(12, 6)
  context             String   @default("unknown") @db.VarChar(64)

  @@index([ts], map: "ix_llm_usage_ledger_ts")
  @@map("llm_usage_ledger")
}

model SentenceLemmaLink {
  id               Int     @id @default(autoincrement())
  sentenceId       Int     @map("sentence_id")
  lemmaId          Int     @map("lemma_id")
  senseId          Int?    @map("sense_id")
  wordPosition     Int?    @map("word_position")
  matchedForm      String? @map("matched_form") @db.VarChar
  score            Float   @default(0)
  isRepresentative Boolean @default(false) @map("is_representative")

  sentence SentenceBank @relation(fields: [sentenceId], references: [id], onDelete: Cascade)
  lemma    Lemma        @relation(fields: [lemmaId], references: [id], onDelete: Cascade)
  sense    WordSense?   @relation(fields: [senseId], references: [id], onDelete: SetNull)

  @@unique([sentenceId, lemmaId], map: "unique_sentence_lemma")
  @@index([lemmaId, senseId], map: "ix_sentence_lemma_link_lemma_sense")
  @@map("sentence_lemma_links")
}

// ============================================================

// Words an admin has flagged as misspelled / bad data. Present → hide the
// word from every movie/book vocabulary list. `word` stored lowercased so
// lookups don't care about the original casing in the source material.
model HiddenWord {
  id         Int      @id @default(autoincrement())
  word       String   @unique @db.VarChar
  hiddenById Int      @map("hidden_by_id")
  reason     String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  hiddenBy User @relation("HiddenWordBy", fields: [hiddenById], references: [id], onDelete: Cascade)

  @@index([word], map: "ix_hidden_words_word")
  @@map("hidden_words")
}

model WordReport {
  id                Int          @id @default(autoincrement())
  word              String       @db.VarChar
  movieId           Int?         @map("movie_id")
  movieTitle        String?      @map("movie_title") @db.VarChar
  reason            reportreason
  details           String?      @db.Text
  translationSource String?      @map("translation_source") @db.VarChar
  status            reportstatus @default(PENDING)
  reporterId        Int          @map("reporter_id")
  reviewerId        Int?         @map("reviewer_id")
  reviewNotes       String?      @map("review_notes") @db.Text
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  reporter User   @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer User?  @relation("ReviewedBy", fields: [reviewerId], references: [id], onDelete: SetNull)
  movie    Movie? @relation(fields: [movieId], references: [id], onDelete: SetNull)

  @@index([status], map: "ix_word_reports_status")
  @@index([word], map: "ix_word_reports_word")
  @@index([reporterId], map: "ix_word_reports_reporter")
  @@map("word_reports")
}

// --- Quiz / gamification ---------------------------------------------------

model QuizSession {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  movieId      Int?      @map("movie_id")
  cefrLevel    String    @map("cefr_level") @db.VarChar(2)
  kind         String    @db.VarChar(16) // "unit" | "pre_movie"
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  stars        Int? // 0..3, null while in-progress
  correctCount Int       @default(0) @map("correct_count")
  totalScored  Int       @default(0) @map("total_scored")

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards QuizCardResult[]

  @@index([userId, movieId, cefrLevel], map: "ix_quiz_sessions_user_movie_level")
  @@index([completedAt], map: "ix_quiz_sessions_completed_at")
  @@map("quiz_sessions")
}

model QuizCardResult {
  id         Int      @id @default(autoincrement())
  sessionId  Int      @map("session_id")
  word       String   @db.VarChar
  cardType   String   @map("card_type") @db.VarChar(16) // "mcq" | "self_rate"
  isCorrect  Boolean? @map("is_correct") // null for self_rate
  selfRating String?  @map("self_rating") @db.VarChar(8) // "know" | "kinda" | "dont"
  answerMs   Int      @map("answer_ms")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId], map: "ix_quiz_card_results_session")
  @@index([word], map: "ix_quiz_card_results_word")
  @@map("quiz_card_results")
}

model UserQuizStats {
  userId         Int      @id @map("user_id")
  totalStars     Int      @default(0) @map("total_stars")
  totalSessions  Int      @default(0) @map("total_sessions")
  avgAccuracy    Float    @default(0) @map("avg_accuracy")
  retentionScore Float    @default(0) @map("retention_score") // % correct on re-quiz ≥7d later
  xp             Int      @default(0)
  lastActiveAt   DateTime @default(now()) @map("last_active_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([totalStars], map: "ix_user_quiz_stats_total_stars")
  @@index([xp], map: "ix_user_quiz_stats_xp")
  @@index([retentionScore], map: "ix_user_quiz_stats_retention")
  @@map("user_quiz_stats")
}

model UnitProgress {
  userId    Int      @map("user_id")
  movieId   Int      @map("movie_id")
  cefrLevel String   @map("cefr_level") @db.VarChar(2)
  bestStars Int      @default(0) @map("best_stars")
  attempts  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, movieId, cefrLevel])
  @@index([userId, movieId], map: "ix_unit_progress_user_movie")
  @@map("unit_progress")
}

model UserReelMovie {
  userId     Int      @map("user_id")
  tmdbId     Int      @map("tmdb_id")
  position   Int
  title      String   @db.VarChar
  posterPath String?  @map("poster_path") @db.VarChar
  year       Int?
  addedAt    DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, tmdbId])
  @@unique([userId, position], map: "ux_user_reel_movies_user_position")
  @@index([userId, addedAt], map: "ix_user_reel_movies_user_added_at")
  @@map("user_reel_movies")
}

// Per-user "Watched" list — movies the user marked as already seen (swipe
// right on the home feed). Distinct from the reel (a study queue): these are
// excluded from the CEFR feed so already-seen films don't resurface. Title/
// poster/year are denormalized so the Watched screen renders without per-row
// TMDB roundtrips (same as UserReelMovie).
model UserWatchedMovie {
  userId     Int      @map("user_id")
  tmdbId     Int      @map("tmdb_id")
  title      String   @db.VarChar
  posterPath String?  @map("poster_path") @db.VarChar
  year       Int?
  watchedAt  DateTime @default(now()) @map("watched_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, tmdbId])
  @@index([userId, watchedAt], map: "ix_user_watched_movies_user_watched_at")
  @@map("user_watched_movies")
}

// Per-user "Not interested" set — movies the user dismissed from the home
// feed (swipe left). No denormalized metadata: these are only ever used as an
// exclusion filter on the CEFR feed, never listed back to the user.
model UserHiddenMovie {
  userId   Int      @map("user_id")
  tmdbId   Int      @map("tmdb_id")
  hiddenAt DateTime @default(now()) @map("hidden_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, tmdbId])
  @@index([userId, hiddenAt], map: "ix_user_hidden_movies_user_hidden_at")
  @@map("user_hidden_movies")
}

// Per-(user, movie) progress cache used by the reel UI (status badges,
// comprehensibility %) and the "Ready to Watch" recommendation surface.
// Recomputed after any quiz/SRS completion that touched UserWord rows.
// See backend/src/services/movie_progress_service.py.
model UserMovieProgress {
  userId                   Int              @map("user_id")
  movieId                  Int              @map("movie_id")
  lemmasTouched            Int              @default(0) @map("lemmas_touched")
  lemmasInBox2Plus         Int              @default(0) @map("lemmas_in_box_2_plus")
  lemmasMastered           Int              @default(0) @map("lemmas_mastered")
  // Frequency-weighted % of the movie's lemmas the user has reached
  // srsBox >= 2 on. Stored 0..100 (not 0..1) for client display.
  comprehensibilityPercent Float            @default(0) @map("comprehensibility_percent")
  status                   moviestudystatus @default(unstudied)
  updatedAt                DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@index([userId], map: "ix_user_movie_progress_user")
  @@index([userId, comprehensibilityPercent(sort: Desc)], map: "ix_user_movie_progress_comprehensibility")
  @@map("user_movie_progress")
}

// Per-user inventory of streak freezes (v0.6 mercy infrastructure).
// One row per freeze; `consumedAt IS NULL` means the freeze is still
// held. Auto-granted weekly to free users (cap 2 held), credited in
// batches by the consumable freeze-pack IAP, and lazily consumed at
// the next /daily/state read after a missed day.
model UserStreakFreeze {
  id             Int               @id @default(autoincrement())
  userId         Int               @map("user_id")
  acquiredAt     DateTime          @default(now()) @map("acquired_at") @db.Timestamptz(6)
  acquiredVia    freezeacquisition @map("acquired_via")
  consumedAt     DateTime?         @map("consumed_at") @db.Timestamptz(6)
  consumedReason String?           @map("consumed_reason") @db.VarChar

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Hot index for "how many freezes does this user have?"
  @@index([userId, consumedAt], map: "ix_user_streak_freezes_held")
  @@map("user_streak_freezes")
}

// ============================================================
// Scaffold-feature tables (feature flags, gamification badges,
// family plan, student discount).
//
// These were previously created only by hand outside the repo — the
// routes in feature_flags.py / gamification.py / family.py /
// student_discount.py query them with raw SQL and 500'd on any fresh
// database. Defining them here makes the schema reproducible; the raw
// SQL in those routes keeps working because the @map names match.
// Provisioning SQL for existing environments lives in
// migrations_manual/2026_07_03_scaffold_tables.sql.
// ============================================================

model FeatureFlag {
  id          Int      @id @default(autoincrement())
  flagKey     String   @unique @map("flag_key") @db.VarChar(100)
  description String?  @db.Text
  enabled     Boolean  @default(false)
  rolloutPct  Int      @default(100) @map("rollout_pct")
  variants    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // DB-side default (not just Prisma @updatedAt) because the flag routes
  // write via raw SQL, which bypasses Prisma's client-side timestamps.
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  userAssignments UserFeatureFlag[]

  @@map("feature_flags")
}

model UserFeatureFlag {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  flagKey    String   @map("flag_key") @db.VarChar(100)
  variant    String?  @db.VarChar(50)
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  flag FeatureFlag @relation(fields: [flagKey], references: [flagKey], onDelete: Cascade)

  // Backs the ON CONFLICT (user_id, flag_key) upsert in /flags/me.
  @@unique([userId, flagKey])
  @@map("user_feature_flags")
}

model Achievement {
  key         String  @id @db.VarChar(50)
  title       String  @db.VarChar(200)
  description String? @db.Text
  icon        String? @db.VarChar(20)
  category    String  @db.VarChar(30)
  threshold   Int     @default(1)

  userProgress UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  achievementKey String    @map("achievement_key") @db.VarChar(50)
  progress       Int       @default(0)
  unlocked       Boolean   @default(false)
  unlockedAt     DateTime? @map("unlocked_at") @db.Timestamptz(6)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementKey], references: [key], onDelete: Cascade)

  // Backs the ON CONFLICT (user_id, achievement_key) upsert in check_and_unlock.
  @@unique([userId, achievementKey])
  @@map("user_achievements")
}

model FamilyPlan {
  id         Int      @id @default(autoincrement())
  // One plan per owner — /family/plan assumes a single row per user.
  ownerId    Int      @unique @map("owner_id")
  maxMembers Int      @default(5) @map("max_members")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner   User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members FamilyMember[]

  @@map("family_plans")
}

model FamilyMember {
  id       Int      @id @default(autoincrement())
  planId   Int      @map("plan_id")
  userId   Int      @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  plan FamilyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([planId, userId])
  @@map("family_members")
}

model StudentVerification {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  email      String?   @db.VarChar(255)
  method     String    @db.VarChar(20)
  verified   Boolean   @default(false)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Backs the ON CONFLICT (user_id, method) upsert in /student/verify.
  // Map matches the constraint name Postgres already generated in
  // environments where the old request-time CREATE TABLE ran.
  @@unique([userId, method], map: "student_verifications_user_id_method_key")
  @@map("student_verifications")
}
